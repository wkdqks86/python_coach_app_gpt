# Supabase Dashboard → Connect에서 Session pooler 연결 문자열을 복사해 넣습니다.
# 비밀번호는 절대로 Git에 올리지 말고 Render의 Environment Variables에만 입력하세요.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-[region].pooler.supabase.com:5432/postgres

# 쉼표로 구분해 여러 프론트엔드 주소를 허용할 수 있습니다.
CORS_ORIGINS=https://your-project.vercel.app
